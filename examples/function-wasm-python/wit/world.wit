// WASI at the version wasmtime-wasi-http 50.0.1 links.
/// This guest's world: the guestfn:function contract in its sync form (the
/// shape componentize-py takes), plus wasi:http@0.2's outgoing-handler for
/// its CMDB request. The runtime serves both wasi:http generations
/// through one egress policy.
package local:guest;

world function {
    include guestfn:function/function-sync@1.0.0;

    import wasi:http/outgoing-handler@0.2.12;
}
