.{
    .name = .function_wasm_cpp,
    .version = "0.1.0",
    .minimum_zig_version = "0.16.0",
    .fingerprint = 0x482a61cd8f36eb28,
    .dependencies = .{
        // The protobuf codec: three C files, heap-allocating decode/encode
        // (PB_ENABLE_MALLOC) over the structs nanopb_generator writes from the
        // vendored proto (src/fnv1).
        .nanopb = .{
            .url = "https://github.com/nanopb/nanopb/archive/refs/tags/0.4.9.3.tar.gz",
            .hash = "N-V-__8AAN6KKQB9rGQUAHNvQUF3wvivjsjVtFg_Rr2xXCRY",
        },
        // The TLS library the guest reads and writes certificates with,
        // configured by src/cert_rotator_mbedtls_config.h: X.509, ECDSA over
        // P-256, SHA-256, PEM and base64, and nothing that needs a socket,
        // a file or a clock. The sources build.zig lists are compiled with
        // zig cc, like nanopb.
        .mbedtls = .{
            .url = "https://github.com/Mbed-TLS/mbedtls/archive/refs/tags/mbedtls-3.6.7.tar.gz",
            .hash = "N-V-__8AALrvlQKVtYlvv9dpBnbrJfdwR_F0wAgwsvZhAF1Y",
        },
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
        "proto",
        "wit",
    },
}
