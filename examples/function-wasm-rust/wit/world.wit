/// This guest's own world, in a local package: the guestfn:function contract
/// (deps/guestfn-function.wit, kept byte-identical to the runtime's copy) plus
/// the wasi:http client it fetches Cloudflare's IP ranges with. A component
/// may import more than the wasmfn world names; the host links wasi:http for
/// every v2 run and the grant decides what answers it.
package local:guest;

world function {
    include guestfn:function/function@1.0.0;

    import wasi:http/client@0.3.0;
}
