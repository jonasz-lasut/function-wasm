import {
  "jonasz-lasut/function-wasm-moonbit/gen/world/function" @function,
}

warnings = "-44-implicit_impl_as_method-deprecated_syntax-deprecated"

pkgtype(kind: "foreign_library")

options(
  link: {
    "wasm": {
      "export-memory-name": "memory",
      "heap-start-address": 16,
      "exports": [
        "mbt_ffi_cabi_realloc:cabi_realloc",
        "wasmExportRun:run",
        "wasmExportRunPostReturn:cabi_post_run"
      ],
    },
  },
)
