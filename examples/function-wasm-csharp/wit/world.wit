/// This guest's world: the guestfn:function contract in its sync form
/// (wit-bindgen's C# async bindings do not compile for it yet), plus
/// wasi:http@0.2's outgoing-handler to fetch the bundle. The runtime serves
/// both wasi:http generations through one egress policy.
package local:guest;

world function {
    include guestfn:function/function-sync@1.0.0;

    import wasi:http/outgoing-handler@0.2.12;
}
