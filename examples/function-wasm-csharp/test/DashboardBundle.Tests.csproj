<Project Sdk="Microsoft.NET.Sdk">

  <!-- The function under plain .NET: everything under src/ compiled for the
       host, src/App.cs (the world wiring) left out. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../src/**/*.cs" Exclude="../src/App.cs" LinkBase="src" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Google.Protobuf" />
    <PackageReference Include="MSTest" />
  </ItemGroup>

</Project>
