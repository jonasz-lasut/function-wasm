/// This guest's world: the guestfn:function contract in its sync form (the
/// shape its generator binds without a callback-driven task), plus
/// wasi:http@0.2's outgoing-handler for its greeting fetch. The runtime
/// serves both wasi:http generations through one egress policy.
package local:guest;

world function {
    include guestfn:function/function-sync@1.0.0;

    import wasi:http/outgoing-handler@0.2.12;
}
