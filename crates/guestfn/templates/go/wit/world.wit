/// This guest's world: the guestfn:function contract in its sync form (the
/// shape stock Go builds), plus wasi:http@0.2's outgoing-handler, what
/// wasmfn.HTTPClient() sends through. The runtime serves both wasi:http
/// generations through one egress policy. wit-bindgen's Go generator writes
/// internal/bindings from it, and guestfn build embeds it into the core
/// module go build emits before wrapping that into the component.
package local:guest;

world function {
    include guestfn:function/function-sync@1.0.0;

    import wasi:http/outgoing-handler@0.2.12;
}
