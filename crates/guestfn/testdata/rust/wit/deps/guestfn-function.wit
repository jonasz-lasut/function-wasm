/// The guestfn guest contract, ABI v2 (docs/abi-v2.md).
///
/// A guest is a WebAssembly component targeting one of this package's two
/// worlds; a core module is refused at load (ABI v1, the core-module contract,
/// was removed in function-wasm 1.0.0). The payload is protobuf:
/// RunFunctionRequest bytes in, RunFunctionResponse bytes out - payload
/// evolution stays protobuf's job. The package is final: 1.0.0 is the contract
/// from function-wasm 1.0.0 on. A 1.x minor may add imports a guest may use and
/// nothing else; run, log and anything already here change only with 2.0.0
/// (docs/abi-v2.md, Versioning).
package guestfn:function@1.0.0;

/// The world the runtime checks a guest against. Target it from a toolchain
/// that can async-lift `run`.
world function {
  /// The level of a guest log line, rendered at the runtime's level of the
  /// same name; debug lines show only when the runtime runs under --debug.
  enum log-level {
    debug,
    info,
    warn,
    error,
  }
  /// Structured logging through the host: one line, message plus key-value
  /// pairs, attached to the module's identity in the runtime's log.
  import log: func(level: log-level, msg: string, kv: list<tuple<string, string>>);

  /// One request: RunFunctionRequest bytes in, RunFunctionResponse bytes
  /// out. A returned error string becomes the request's fatal result; a
  /// guest that can produce a response encodes failures into the response
  /// (a fatal Result) instead.
  export run: async func(request: list<u8>) -> result<list<u8>, string>;
}
/// The same contract with `run` declared sync, for a toolchain that cannot
/// async-lift it. A sync-lifted `run` satisfies the `function` world.
world function-sync {
  /// The level of a guest log line, rendered at the runtime's level of the
  /// same name; debug lines show only when the runtime runs under --debug.
  enum log-level {
    debug,
    info,
    warn,
    error,
  }
  /// Structured logging through the host: one line, message plus key-value
  /// pairs, attached to the module's identity in the runtime's log.
  import log: func(level: log-level, msg: string, kv: list<tuple<string, string>>);

  /// One request: RunFunctionRequest bytes in, RunFunctionResponse bytes
  /// out. A returned error string becomes the request's fatal result; a
  /// guest that can produce a response encodes failures into the response
  /// (a fatal Result) instead.
  export run: func(request: list<u8>) -> result<list<u8>, string>;
}
