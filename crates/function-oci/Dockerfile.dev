# syntax=docker/dockerfile:1

# The function-oci runtime image around binaries built elsewhere, as
# crates/function-wasm/Dockerfile.dev wraps the function-wasm one: the OCI
# workflow builds the function-oci binary and the init and fetches Firecracker and the kernel
# once (make oci.tools), then wraps them here. The build context is a
# directory holding the binary as `function`, `init`, `firecracker` and
# `vmlinux` for the platform the image is built for.
FROM cgr.dev/chainguard/glibc-dynamic:latest@sha256:041dfc2e4c197c610880f3f39643f76bf881698a51f329aa38c9d0657ba5741c
WORKDIR /
COPY function /function
COPY init /usr/lib/guestfn/init
COPY firecracker /usr/lib/guestfn/firecracker
COPY vmlinux /usr/lib/guestfn/vmlinux
EXPOSE 9443
USER nonroot:nonroot
ENTRYPOINT ["/function"]
