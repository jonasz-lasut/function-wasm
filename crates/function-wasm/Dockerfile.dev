# syntax=docker/dockerfile:1

# The runtime image around a binary built elsewhere: the end-to-end workflow
# compiles the runtime once with a warm cargo cache (its build-tools job) and
# wraps it here, instead of compiling the workspace cold in the build stage
# of the Dockerfile beside this one. The build context is a directory holding the linux binary as
# `function`, for the platform the image is built for:
#
#   docker buildx build -f crates/function-wasm/Dockerfile.dev --platform linux/amd64 -t function-wasm-e2e:dev <dir>
#
# The base is that Dockerfile's (see there for why glibc-dynamic); Renovate
# keeps both digests current.
FROM cgr.dev/chainguard/glibc-dynamic:latest@sha256:cb7aa4681bef604e99ad3fb6fb365330a3ca24fcee56df0b60b27ac4983409eb
WORKDIR /
COPY function /function
EXPOSE 9443
USER nonroot:nonroot
ENTRYPOINT ["/function"]
