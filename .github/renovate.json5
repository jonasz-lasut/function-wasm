{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:recommended',
    // Workflows pin every action to a commit SHA with a `# vX.Y.Z` comment;
    // keep it that way and resolve the comment to a full semver tag.
    'helpers:pinGitHubActionDigestsToSemver',
    // The repo uses conventional commits; a routine bump is a chore, not a fix.
    ':semanticCommitTypeAll(chore)',
  ],
  // The dependency surfaces: the Cargo workspace, the workflows (actions and
  // the CLI versions in their env), and the Dockerfile. The Dockerfile's
  // rust:1 build stage floats by design; its runtime base
  // (cgr.dev/chainguard/glibc-dynamic, a `latest`-only image) is digest-pinned
  // and the dockerfile manager keeps that digest current.
  //
  // The example guests and the scaffold goldens are NOT a surface: they
  // mirror the templates under crates/guestfn/templates, which Renovate
  // cannot parse (`.tmpl`), so a bot bump desyncs the three copies and fails
  // the render-matches goldens. Their dependencies - and the function package
  // refs in their render files - move by hand, together with the templates.
  enabledManagers: ['cargo', 'github-actions', 'dockerfile', 'custom.regex'],
  // config:recommended's :ignoreModulesAndTests skips **/examples/**, so
  // Renovate never read a file there: the version-header tripwire below
  // moved the templates and goldens but not the examples. ignorePaths is
  // not mergeable (this list replaces the preset's), so it repeats the
  // preset minus examples; the examples' own dependencies stay off through
  // the packageRule that disables everything under examples/.
  ignorePaths: [
    '**/node_modules/**',
    '**/bower_components/**',
    '**/vendor/**',
    '**/__tests__/**',
    '**/test/**',
    '**/tests/**',
    '**/__fixtures__/**',
  ],
  osvVulnerabilityAlerts: true,
  // A security PR is forced onto its own branch with update-lockfile, which
  // no packageRule can override - and update-lockfile cannot move a wasmtime
  // crate alone (see the wasmtime rule below). `bump` writes the fixed
  // version into the manifest instead, so the lockfile is re-resolved as a
  // whole and the vulnerable version can no longer be selected.
  vulnerabilityAlerts: { rangeStrategy: 'bump' },
  customManagers: [
    {
      // Crossplane CLI version installed by install.sh in the release workflows.
      // Since v2.3.0 the CLI is released from crossplane/cli (XP_CHANNEL=stable).
      customType: 'regex',
      description: 'XP_VERSION in .github/workflows',
      managerFilePatterns: ['/^\\.github/workflows/[^/]+\\.ya?ml$/'],
      matchStrings: ["XP_VERSION: '(?<currentValue>v[^']+)'"],
      depNameTemplate: 'crossplane/cli',
      datasourceTemplate: 'github-releases',
    },
    {
      // The crossplane/crossplane release every vendored run_function.proto
      // was copied from - the same tripwire function-sdk-rust carries. A bump
      // PR moves the version in the header comment of all copies at once; it
      // does NOT re-download the file or regenerate the guests' codecs, so
      // treat the PR as the signal to run `make vendor-proto` on its branch
      // (the root Makefile re-vendors every copy at the new version,
      // regenerates the codecs and refreshes the goldens) and push the
      // result. Merging it without that would claim a version the file is
      // not.
      customType: 'regex',
      description: 'crossplane/crossplane release the vendored run_function.proto came from',
      managerFilePatterns: ['/(^|/)proto/run_function\\.proto$/'],
      matchStrings: [
        'Vendored from crossplane/crossplane (?<currentValue>v\\d+\\.\\d+\\.\\d+)\\.',
      ],
      depNameTemplate: 'crossplane/crossplane',
      datasourceTemplate: 'github-releases',
    },
    {
      // The wasmtime-wasi-http release every vendored WASI WIT file under a
      // wit/deps/ was copied from: its src/p3/wit/deps for the rust scaffold
      // and hello-rust-v2, its wit/deps for hello-python. Same tripwire as
      // the proto: a bump PR moves the version in every header at once; it
      // does NOT re-download the WIT, so treat the PR as the signal to
      // re-vendor by hand (keeping the p3 http.wit's service/middleware
      // trim) and refresh the goldens. The header names an exact release,
      // hence semver rather than the crate datasource's cargo ranges, under
      // which `49.0.2` reads as `^49.0.2`.
      customType: 'regex',
      description: 'wasmtime-wasi-http release the vendored WASI WIT came from',
      managerFilePatterns: ['/(^|/)wit/deps/[^/]+\\.wit$/'],
      matchStrings: [
        'Vendored from wasmtime-wasi-http (?<currentValue>\\d+\\.\\d+\\.\\d+) ',
      ],
      depNameTemplate: 'wasmtime-wasi-http',
      datasourceTemplate: 'crate',
      versioningTemplate: 'semver',
    },
  ],
  // Rules are evaluated in order; later rules win.
  packageRules: [
    // GitHub Actions: let a release settle before pulling its digest, batch
    // non-major bumps into one PR, and keep majors as separate PRs since they
    // tend to need workflow changes.
    { matchManagers: ['github-actions'], minimumReleaseAge: '3 days' },
    {
      matchManagers: ['github-actions'],
      matchUpdateTypes: ['minor', 'patch', 'digest', 'pin', 'pinDigest'],
      groupName: 'github-actions',
    },

    // The workspace crates move together.
    { matchManagers: ['cargo'], groupName: 'rust' },

    // The wasmtime crates pin one another to exact versions (`=48.0.4`), so
    // they resolve only as one family. For a lockfile-only update Renovate
    // runs `cargo update --precise` crate by crate, and each of those fails
    // on the siblings' pins; once the manifest requirement changes it skips
    // that step and one `cargo update --workspace` moves the whole family.
    // Hence their own group, and `bump` so every update changes Cargo.toml.
    // The vendored WASI WIT headers join the group, so the PR that moves
    // the crates is also the one that asks for the re-vendoring.
    {
      matchManagers: ['cargo', 'custom.regex'],
      matchPackageNames: ['wasmtime', 'wasmtime-*'],
      groupName: 'wasmtime',
      rangeStrategy: 'bump',
    },

    // Dockerfile: the rust build stage floats by design; the runtime base is
    // pinned to a digest that moves with Chainguard's daily rebuilds - one PR
    // per digest bump, so a rebuild that breaks the image is judged on its
    // own.
    { matchManagers: ['dockerfile'], matchPackageNames: ['rust'], enabled: false },
    {
      matchManagers: ['dockerfile'],
      matchPackageNames: ['cgr.dev/chainguard/glibc-dynamic'],
      pinDigests: true,
      groupName: 'runtime image',
    },

    // Nothing under the example guests or the scaffold goldens (see the
    // surface note above).
    {
      matchFileNames: ['examples/**', 'crates/guestfn/testdata/**'],
      enabled: false,
    },

    // The one exception, and the reason it is safe: the vendored proto's
    // version header is the same dep in all sixteen copies, so Renovate
    // moves templates, goldens and examples in a single PR - the examples
    // only because ignorePaths above no longer skips them. Left disabled
    // under those paths it would update the templates alone - desyncing the
    // very copies the rule above exists to protect.
    {
      matchManagers: ['custom.regex'],
      matchPackageNames: ['crossplane/crossplane'],
      enabled: true,
      groupName: 'vendored run_function.proto',
    },
    // The WASI WIT headers, for the same reason: one dep across the rust
    // template, its golden, hello-rust-v2 and hello-python. Their group is
    // the wasmtime one above.
    {
      matchManagers: ['custom.regex'],
      matchPackageNames: ['wasmtime-wasi-http'],
      enabled: true,
    },
  ],
}
