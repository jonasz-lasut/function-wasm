{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:recommended',
    // Workflows pin every action to a commit SHA with a `# vX.Y.Z` comment;
    // keep it that way and resolve the comment to a full semver tag.
    'helpers:pinGitHubActionDigestsToSemver',
    // The repo uses conventional commits; a routine bump is a chore, not a fix.
    ':semanticCommitTypeAll(chore)',
  ],
  // The dependency surfaces: the Cargo workspace, the workflows (actions and
  // the CLI versions in their env), and the Dockerfile. The Dockerfile's
  // rust:1 build stage floats by design; its runtime base
  // (cgr.dev/chainguard/glibc-dynamic, a `latest`-only image) is digest-pinned
  // and the dockerfile manager keeps that digest current.
  //
  // The scaffold goldens are NOT a surface, and the example guests are one
  // only once a month: both mirror the templates under
  // crates/guestfn/templates, which Renovate cannot parse (`.tmpl`), so a
  // bot bump of a pin the templates share desyncs the three copies and fails
  // the render-matches goldens. Those pins - and the function package refs
  // in the render files - move by hand at release time, together with the
  // templates (the cut-release skill). What the examples own alone is
  // refreshed by the monthly examples rules at the end of packageRules
  // (SECURITY.md has the policy). gomod, npm and nuget are here for those
  // rules only; every other file they find stays disabled. pip_requirements
  // is not enabled at all: every requirements.txt is the python template's
  // pins - a plain file in the template too, which the manager would read
  // and bump alone - and those move with the template at release.
  enabledManagers: [
    'cargo',
    'github-actions',
    'dockerfile',
    'custom.regex',
    'gomod',
    'npm',
    'nuget',
  ],
  // config:recommended's :ignoreModulesAndTests skips **/examples/**, so
  // Renovate never read a file there: the version-header tripwire below
  // moved the templates and goldens but not the examples. ignorePaths is
  // not mergeable (this list replaces the preset's), so it repeats the
  // preset minus examples; the examples' own dependencies stay off through
  // the packageRule that disables everything under examples/, but for what
  // the monthly examples rules switch back on.
  ignorePaths: [
    '**/node_modules/**',
    '**/bower_components/**',
    '**/vendor/**',
    '**/__tests__/**',
    '**/test/**',
    '**/tests/**',
    '**/__fixtures__/**',
  ],
  // The same preset gives nuget a list of its own (keeping .NET test
  // projects in), which skips examples too and which the list above does
  // not replace: it repeats the preset's nuget list minus examples.
  nuget: {
    ignorePaths: [
      '**/node_modules/**',
      '**/bower_components/**',
      '**/vendor/**',
      '**/__fixtures__/**',
    ],
  },
  osvVulnerabilityAlerts: true,
  // A security PR is forced onto its own branch with update-lockfile, which
  // no packageRule can override - and update-lockfile cannot move a wasmtime
  // crate alone (see the wasmtime rule below). `bump` writes the fixed
  // version into the manifest instead, so the lockfile is re-resolved as a
  // whole and the vulnerable version can no longer be selected.
  vulnerabilityAlerts: { rangeStrategy: 'bump' },
  // Lock file maintenance, for the example lockfiles only. Renovate reads
  // this flag per package file before any packageRule runs, so a rule can
  // switch lock file maintenance off but never on: it is on here, the
  // examples rules switch it off for every package file - the workspace's
  // Cargo.lock included - and back on for the four example lockfiles.
  lockFileMaintenance: { enabled: true },
  customManagers: [
    {
      // Crossplane CLI version installed by install.sh in the release workflows.
      // Since v2.3.0 the CLI is released from crossplane/cli (XP_CHANNEL=stable).
      customType: 'regex',
      description: 'XP_VERSION in .github/workflows',
      managerFilePatterns: ['/^\\.github/workflows/[^/]+\\.ya?ml$/'],
      matchStrings: ["XP_VERSION: '(?<currentValue>v[^']+)'"],
      depNameTemplate: 'crossplane/cli',
      datasourceTemplate: 'github-releases',
    },
    {
      // The crossplane/crossplane release every vendored run_function.proto
      // was copied from - the same tripwire function-sdk-rust carries. A bump
      // PR moves the version in the header comment of all copies at once; it
      // does NOT re-download the file or regenerate the guests' codecs, so
      // treat the PR as the signal to run `make vendor-proto` on its branch
      // (the root Makefile re-vendors every copy at the new version,
      // regenerates the codecs and refreshes the goldens) and push the
      // result. Merging it without that would claim a version the file is
      // not.
      customType: 'regex',
      description: 'crossplane/crossplane release the vendored run_function.proto came from',
      managerFilePatterns: ['/(^|/)proto/run_function\\.proto$/'],
      matchStrings: [
        'Vendored from crossplane/crossplane (?<currentValue>v\\d+\\.\\d+\\.\\d+)\\.',
      ],
      depNameTemplate: 'crossplane/crossplane',
      datasourceTemplate: 'github-releases',
    },
    {
      // The wasmtime-wasi-http release every vendored WASI WIT file under a
      // wit/deps/ was copied from: its src/p3/wit/deps for the rust scaffold
      // and cloudflare-origin, its wit/deps for the python, c, zig and go
      // scaffolds, team-tags, hello-c, hello-zig, pdb-addon and
      // dashboard-bundle (templates and goldens included: the
      // files are plain .wit in all of them). Same tripwire as the proto: a
      // bump PR moves the version in every header at once; it does NOT
      // re-download the WIT, so treat the PR as the signal to re-vendor by
      // hand (keeping the p3 http.wit's service/middleware trim) and refresh
      // the goldens. The header names an exact release, hence semver rather
      // than the crate datasource's cargo ranges, under which `49.0.2` reads
      // as `^49.0.2`.
      customType: 'regex',
      description: 'wasmtime-wasi-http release the vendored WASI WIT came from',
      managerFilePatterns: ['/(^|/)wit/deps/[^/]+\\.wit$/'],
      matchStrings: [
        'Vendored from wasmtime-wasi-http (?<currentValue>\\d+\\.\\d+\\.\\d+) ',
      ],
      depNameTemplate: 'wasmtime-wasi-http',
      datasourceTemplate: 'crate',
      versioningTemplate: 'semver',
    },
  ],
  // Rules are evaluated in order; later rules win.
  packageRules: [
    // GitHub Actions: let a release settle before pulling its digest, batch
    // non-major bumps into one PR, and keep majors as separate PRs since they
    // tend to need workflow changes.
    { matchManagers: ['github-actions'], minimumReleaseAge: '3 days' },
    {
      matchManagers: ['github-actions'],
      matchUpdateTypes: ['minor', 'patch', 'digest', 'pin', 'pinDigest'],
      groupName: 'github-actions',
    },

    // The workspace crates move together.
    { matchManagers: ['cargo'], groupName: 'rust' },

    // The wasmtime crates pin one another to exact versions (`=48.0.4`), so
    // they resolve only as one family. For a lockfile-only update Renovate
    // runs `cargo update --precise` crate by crate, and each of those fails
    // on the siblings' pins; once the manifest requirement changes it skips
    // that step and one `cargo update --workspace` moves the whole family.
    // Hence their own group, and `bump` so every update changes Cargo.toml.
    // The vendored WASI WIT headers join the group, so the PR that moves
    // the crates is also the one that asks for the re-vendoring. So does
    // the wasip1 adapter provider: built in the wasmtime repository and
    // published at its version, it is the adapter guestfn build links into
    // a component (crates/engine/src/componentize.rs) and must stay the one
    // the engine's wasmtime-wasi was released with.
    {
      matchManagers: ['cargo', 'custom.regex'],
      matchPackageNames: ['wasmtime', 'wasmtime-*', 'wasi-preview1-component-adapter-provider'],
      groupName: 'wasmtime',
      rangeStrategy: 'bump',
    },
    // wit-component, wasmparser and wit-parser are pinned to the versions
    // wasmtime's own bindgen pulls (crates/engine/Cargo.toml), so no second
    // copy is compiled. Renovate leaves them alone: a bump on their own
    // would only add that copy (#140). They move by hand in the wasmtime
    // group's PR, to whatever `cargo tree -i wit-component` shows wasmtime
    // pulling after the bump.
    {
      matchManagers: ['cargo'],
      matchPackageNames: ['wit-component', 'wasmparser', 'wit-parser'],
      enabled: false,
    },

    // Dockerfile: the rust build stage floats by design; the runtime base is
    // pinned to a digest that moves with Chainguard's daily rebuilds - one PR
    // per digest bump, so a rebuild that breaks the image is judged on its
    // own.
    { matchManagers: ['dockerfile'], matchPackageNames: ['rust'], enabled: false },
    {
      matchManagers: ['dockerfile'],
      matchPackageNames: ['cgr.dev/chainguard/glibc-dynamic'],
      pinDigests: true,
      groupName: 'runtime image',
    },

    // Nothing under the example guests or the scaffold goldens (see the
    // surface note above), but for the exceptions below.
    {
      matchFileNames: ['examples/**', 'crates/guestfn/testdata/**'],
      enabled: false,
    },

    // The one exception, and the reason it is safe: the vendored proto's
    // version header is the same dep in all twenty copies, so Renovate
    // moves templates, goldens and examples in a single PR - the examples
    // only because ignorePaths above no longer skips them. Left disabled
    // under those paths it would update the templates alone - desyncing the
    // very copies the rule above exists to protect.
    {
      matchManagers: ['custom.regex'],
      matchPackageNames: ['crossplane/crossplane'],
      enabled: true,
      groupName: 'vendored run_function.proto',
    },
    // The WASI WIT headers, for the same reason: one dep across the rust,
    // python, c, zig and go templates, their goldens, cloudflare-origin,
    // team-tags, hello-c, hello-zig, pdb-addon and dashboard-bundle.
    // Their group is the wasmtime one above.
    {
      matchManagers: ['custom.regex'],
      matchPackageNames: ['wasmtime-wasi-http'],
      enabled: true,
    },

    // The monthly examples refresh. The examples are illustrative and never
    // shipped (the image holds only the runtime binary), so one batch a
    // month, judged by /e2e, keeps them current. These rules switch back on
    // only what an example owns alone, never a pin the templates share.
    //
    // Lock file maintenance: off everywhere first, so the workspace's
    // Cargo.lock keeps the runtime's rules above, then on for the example
    // lockfiles. The lockfiles move within the manifests' ranges and the
    // manifests stay as they are, so nothing drifts from the templates.
    { matchUpdateTypes: ['lockFileMaintenance'], enabled: false },
    {
      matchUpdateTypes: ['lockFileMaintenance'],
      matchFileNames: [
        'examples/cloudflare-origin/Cargo.toml',
        'examples/policy-gate/package.json',
      ],
      enabled: true,
    },
    // gomod has no lock file maintenance, so the Go examples take regular
    // updates. `enabled` here also covers their indirect requirements,
    // which gomod extracts disabled. gomodTidy leaves go.mod and go.sum
    // tidy, so a bump never leaves go.sum behind.
    {
      matchManagers: ['gomod'],
      matchFileNames: ['examples/pdb-addon/go.mod'],
      enabled: true,
      postUpdateOptions: ['gomodTidy'],
    },
    // ...except what the scaffold template pins, which moves with a release
    // instead: the go directive (it also picks the Go toolchain /e2e
    // installs), the go template's function-sdk-go (FALLBACK_SDK_VERSION
    // in crates/guestfn/src/main.rs) and the runtime of its wit-bindgen Go
    // bindings, go.bytecodealliance.org/pkg, pinned at the version the
    // generator targets (it moves with a wit-bindgen bump and `make
    // gen-bindings`, never on its own).
    {
      matchFileNames: ['examples/pdb-addon/go.mod'],
      matchPackageNames: ['go', 'github.com/crossplane/function-sdk-go', 'go.bytecodealliance.org/pkg'],
      enabled: false,
    },
    // dashboard-bundle is example-only, with no template to drift from: its
    // NuGet packages take regular updates. nuget reads every version from
    // its Directory.Packages.props (the projects name packages without one)
    // and looks them up in the sources its nuget.config names.
    {
      matchManagers: ['nuget'],
      matchFileNames: ['examples/dashboard-bundle/**'],
      enabled: true,
    },
    // ...except NativeAOT-LLVM: componentize-dotnet is built against one
    // build of it from the dotnet-experimental feed (which publishes a new
    // one most days), and the compiler for the build host must be that same
    // build. They stay pinned to what componentize-dotnet was released with
    // and move by hand, when a componentize-dotnet update arrives in the
    // batch below - that PR is the signal, and /e2e fails until they move.
    {
      matchManagers: ['nuget'],
      matchPackageNames: ['/^(runtime\\.[a-z0-9-]+\\.)?Microsoft\\.DotNet\\.ILCompiler\\.LLVM$/i'],
      enabled: false,
    },
    // team-tags's requirements.txt is the python template's: its
    // componentize-py and protobuf pins move with the template at release
    // time (the cut-release skill), never in this batch - pip_requirements
    // is not an enabled manager.
    //
    // hello-zig and hello-c name their dependencies in build.zig.zon by URL
    // and content hash, which no Renovate manager reads: they move by hand,
    // with the zig and c templates, at release time.
    //
    // One batch, early on the 1st of the month. Renovate does not group lock
    // file maintenance with other updates - a grouped one gets its own
    // lock-file-maintenance- branch - so the batch is two PRs:
    // renovate/examples (the Go examples and dashboard-bundle) and
    // renovate/lock-file-maintenance-examples (the four lockfiles). A major
    // rides in its batch instead of a PR of its own; /e2e judges the whole.
    // A security update to a Go or .NET example dependency still opens at
    // once on its own branch: Renovate appends those rules after these, with
    // `force`.
    {
      matchManagers: ['cargo', 'npm', 'gomod', 'nuget'],
      matchFileNames: ['examples/**'],
      groupName: 'examples',
      schedule: ['* 0-3 1 * *'],
      separateMajorMinor: false,
    },
    // An indirect requirement's major version is its importer's choice: a
    // bump across it (yaml.v2 to yaml.v3, a /vN path) would replace a module
    // the build still imports instead of updating it. Lookup keeps majors
    // apart for these, so the newest minor or patch is still proposed, and
    // the major is dropped.
    {
      matchManagers: ['gomod'],
      matchFileNames: ['examples/pdb-addon/go.mod'],
      matchDepTypes: ['indirect'],
      separateMajorMinor: true,
    },
    {
      matchManagers: ['gomod'],
      matchFileNames: ['examples/pdb-addon/go.mod'],
      matchDepTypes: ['indirect'],
      matchUpdateTypes: ['major'],
      enabled: false,
    },
  ],
}
