{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:recommended',
    // Workflows pin every action to a commit SHA with a `# vX.Y.Z` comment;
    // keep it that way and resolve the comment to a full semver tag.
    'helpers:pinGitHubActionDigestsToSemver',
    // The repo uses conventional commits; a routine bump is a chore, not a fix.
    ':semanticCommitTypeAll(chore)',
  ],
  // Every pull request Renovate opens runs the whole end-to-end suite: the
  // label selects every scenario of e2e.yml, and e2e-gate, which the
  // ruleset on main requires, then reports on all of them.
  labels: ['e2e:all'],
  // The dependency surfaces: the Cargo workspace, the workflows (actions and
  // the CLI versions in their env), the Dockerfiles and the build submodule.
  // The Dockerfiles' rust:1 build stages float by design; the runtime base
  // (cgr.dev/chainguard/glibc-dynamic, a `latest`-only image) is digest-pinned
  // in crates/function-wasm and crates/function-oci, in each one's Dockerfile
  // and Dockerfile.dev, and the dockerfile manager keeps the digests current.
  //
  // Three pins have no tracker, each for a reason:
  // - debian:bookworm-slim, the stage of crates/function-oci/Dockerfile that
  //   downloads Firecracker and the kernel, floats like rust:1: nothing of
  //   it reaches the image, and what it fetches is held to a checksum.
  // - The guest kernel (KERNEL_CI, KERNEL_VERSION and their checksums, in
  //   that Dockerfile and the release matrix) sits under a dated prefix of
  //   Firecracker's artifact bucket, which no datasource lists: it moves by
  //   hand with the Firecracker pull request.
  // - MoonBit (MOON_VERSION and its two checksums in e2e-wasm.yml) is
  //   served from cli.moonbitlang.com under a version that carries a commit
  //   hash, with no index of releases or checksums to read: it moves by
  //   hand at release time (the cut-release skill), with the generator pins
  //   in function-wasm-moonbit's Makefile.
  //
  // The scaffold goldens are NOT a surface, and the example guests are one
  // only once a month: both mirror the templates under
  // crates/guestfn/templates, which Renovate cannot parse (`.tmpl`), so a
  // bot bump of a pin the templates share desyncs the three copies and fails
  // the render-matches goldens. Those pins - and the function package refs
  // in the render files - move by hand at release time, together with the
  // templates (the cut-release skill). What the examples own alone is
  // refreshed by the monthly examples rules at the end of packageRules
  // (SECURITY.md has the policy). gomod, npm and nuget are here for those
  // rules only; every other file they find stays disabled. pip_requirements
  // is not enabled at all: every requirements.txt is the python template's
  // pins - a plain file in the template too, which the manager would read
  // and bump alone - and those move with the template at release.
  enabledManagers: [
    'cargo',
    'github-actions',
    'dockerfile',
    'custom.regex',
    'gomod',
    'npm',
    'nuget',
    // The crossplane build submodule (build/), the end-to-end suite's make
    // library.
    'git-submodules',
  ],
  // The manager is off by default, and listing it above does not switch it
  // on: without this the submodule, which pins the kind, kubectl, helm and
  // crossplane CLI of every cluster job, never moved.
  'git-submodules': { enabled: true },
  // config:recommended's :ignoreModulesAndTests skips **/examples/**, so
  // Renovate never read a file there: the version-header tripwire below
  // moved the templates and goldens but not the examples. ignorePaths is
  // not mergeable (this list replaces the preset's), so it repeats the
  // preset minus examples; the examples' own dependencies stay off through
  // the packageRule that disables everything under examples/, but for what
  // the monthly examples rules switch back on.
  ignorePaths: [
    '**/node_modules/**',
    '**/bower_components/**',
    '**/vendor/**',
    '**/__tests__/**',
    '**/test/**',
    '**/tests/**',
    '**/__fixtures__/**',
  ],
  // The same preset gives nuget a list of its own (keeping .NET test
  // projects in), which skips examples too and which the list above does
  // not replace: it repeats the preset's nuget list minus examples.
  nuget: {
    ignorePaths: [
      '**/node_modules/**',
      '**/bower_components/**',
      '**/vendor/**',
      '**/__fixtures__/**',
    ],
  },
  osvVulnerabilityAlerts: true,
  // A security PR is forced onto its own branch with update-lockfile, which
  // no packageRule can override - and update-lockfile cannot move a wasmtime
  // crate alone (see the wasmtime rule below). `bump` writes the fixed
  // version into the manifest instead, so the lockfile is re-resolved as a
  // whole and the vulnerable version can no longer be selected.
  vulnerabilityAlerts: { rangeStrategy: 'bump' },
  // Lock file maintenance, for the example lockfiles only. Renovate reads
  // this flag per package file before any packageRule runs, so a rule can
  // switch lock file maintenance off but never on: it is on here, the
  // examples rules switch it off for every package file - the workspace's
  // Cargo.lock included - and back on for the four example lockfiles.
  lockFileMaintenance: { enabled: true },
  customManagers: [
    {
      // The Firecracker release the OCI runtime boots a VM with
      // (docs/one-pager-oci-runtime.md), pinned in
      // crates/function-oci/Dockerfile and read from there by
      // hack/oci-tools.sh, so one file moves. The version
      // comes from the release tag; the two checksums (one per
      // architecture) come from the release's <asset>.sha256.txt attachments,
      // which github-release-attachments reads to update a currentDigest.
      // A match has one digest, so there are two, and they must not
      // overlap: Renovate replaces each match's text as a whole, and two
      // that both began at the version line left the amd64 checksum at the
      // old release (#289). The arm64 checksum has a marker line of its
      // own with the version, and its match starts there.
      // The guest kernel beside it (KERNEL_CI, KERNEL_VERSION and their
      // checksums) sits under a dated prefix of Firecracker's artifact
      // bucket with no datasource: the Firecracker PR is the signal to move
      // it by hand to the kernel that release's CI built.
      customType: 'regex',
      description: 'the Firecracker release crates/function-oci/Dockerfile pins, version and per-architecture checksum',
      managerFilePatterns: ['/^crates/function-oci/Dockerfile$/'],
      matchStrings: [
        'ARG FIRECRACKER_VERSION=(?<currentValue>v\\d+\\.\\d+\\.\\d+)\\n(?:#[^\\n]*\\n)*ARG FIRECRACKER_SHA256_AMD64=(?<currentDigest>[0-9a-f]{64})',
        '# renovate: firecracker (?<currentValue>v\\d+\\.\\d+\\.\\d+) arm64\\nARG FIRECRACKER_SHA256_ARM64=(?<currentDigest>[0-9a-f]{64})',
      ],
      depNameTemplate: 'firecracker',
      packageNameTemplate: 'firecracker-microvm/firecracker',
      datasourceTemplate: 'github-release-attachments',
      versioningTemplate: 'semver',
    },
    {
      // The tools a workflow or the Makefile installs at a pinned version,
      // each under a `# renovate:` comment naming its datasource: lychee
      // (docs.yml), provider-nop (the Makefile),
      // and the three generators the checked-in codecs and bindings were
      // written by, protoc (the Makefile, and the `version` every
      // setup-protoc step installs), nanopb (the Makefile and the
      // `pip install` of e2e-wasm.yml) and wit-bindgen (the Makefile; the
      // workflow's copies are the next manager's). A generator's pull request
      // is the signal to regenerate what it wrote
      // (`make vendor-proto` for protoc and nanopb, with nanopb's source in
      // the c and odin examples' build.zig.zon; `make gen-bindings` for
      // wit-bindgen, with go.bytecodealliance.org/pkg at the version
      // `wit-bindgen go --print-remote-pkg-version` prints) where its output
      // changed, the example build jobs failing on drift until then. Where
      // only the version a protobuf codec's header states would move, the
      // drift checks pass and nothing is regenerated
      // (hack/check-generated.sh); the bindings are compared whole, so a
      // wit-bindgen bump is always a regeneration.
      customType: 'regex',
      description: 'the tool versions a `# renovate:` comment annotates in the workflows and the Makefile',
      managerFilePatterns: ['/^\\.github/workflows/[^/]+\\.ya?ml$/', '/^Makefile$/'],
      matchStrings: [
        "# renovate: datasource=(?<datasource>[^\\s]+) depName=(?<depName>[^\\s]+)(?: versioning=(?<versioning>[^\\s]+))?(?: extractVersion=(?<extractVersion>[^\\s]+))?\\s+(?:PROTOC_VERSION|NANOPB_VERSION|WIT_BINDGEN_VERSION|PROVIDER_NOP_VERSION|lycheeVersion|version) ?(?::=|\\?=|:) ?'?(?<currentValue>[^'\\s]+)'?",
        '# renovate: datasource=(?<datasource>[^\\s]+) depName=(?<depName>[^\\s]+)(?: versioning=(?<versioning>[^\\s]+))?\\s+run: pip install [a-z]+==(?<currentValue>[^\\s]+)',
      ],
    },
    {
      // The tools a workflow downloads as a GitHub release asset and holds
      // to a checksum: wit-bindgen and Odin (e2e-wasm.yml), wkg
      // (publish-wit.yml) and mdBook (docs.yml), each a `<NAME>_VERSION`
      // line with the release's tag as it is, the `<NAME>_SHA256` of the
      // asset under it and a `# renovate: release-asset` comment above.
      // github-release-attachments finds the asset with that checksum in
      // the pinned release and writes the checksum of the same asset in
      // the new one, so the two lines move together; it asks for the
      // release by the pinned value, which is why the value is the tag.
      // Odin's tags are dev-<year>-<month>, which its comment states as a
      // versioning; a re-release with a letter after the month matches no
      // version and is passed over.
      customType: 'regex',
      description: 'the release assets the workflows download, version and checksum',
      managerFilePatterns: ['/^\\.github/workflows/[^/]+\\.ya?ml$/'],
      matchStrings: [
        '# renovate: release-asset depName=(?<depName>[^\\s]+)(?: versioning=(?<versioning>[^\\s]+))?\\s+[A-Z_]+_VERSION: (?<currentValue>[^\\s]+)\\s+[A-Z_]+_SHA256: (?<currentDigest>[0-9a-f]{64})',
      ],
      datasourceTemplate: 'github-release-attachments',
    },
    {
      // Crossplane CLI version installed by install.sh in the release workflows.
      // Since v2.3.0 the CLI is released from crossplane/cli (XP_CHANNEL=stable).
      customType: 'regex',
      description: 'XP_VERSION in .github/workflows',
      managerFilePatterns: ['/^\\.github/workflows/[^/]+\\.ya?ml$/'],
      matchStrings: ["XP_VERSION: '(?<currentValue>v[^']+)'"],
      depNameTemplate: 'crossplane/cli',
      datasourceTemplate: 'github-releases',
    },
    {
      // The Crossplane the end-to-end suite installs: the Makefile's
      // CROSSPLANE_VERSION default (what a pull request's end-to-end run and
      // the matrix's first version test) and the release matrix workflow's two older
      // pins, each a `# renovate:` comment above a `<NAME> ?= x.y.z` or
      // `<NAME>: 'x.y.z'` line. Releases are tagged vX.Y.Z; the pins carry
      // the chart version, without the v. The packageRules below let the
      // default take any release and hold the two older pins to the latest
      // patch of their own minor.
      customType: 'regex',
      description: 'the Crossplane versions the end-to-end suite installs, and the older Firecracker minors of the release matrix',
      managerFilePatterns: ['/^Makefile$/', '/^\\.github/workflows/release-matrix-e2e\\.ya?ml$/'],
      matchStrings: [
        "# renovate: datasource=(?<datasource>[^\\s]+) depName=(?<depName>[^\\s]+)\\s+(?:CROSSPLANE|FIRECRACKER)_[A-Z_]+ ?[?:]?=? ?'?(?<currentValue>\\d+\\.\\d+\\.\\d+)'?",
      ],
      extractVersionTemplate: '^v(?<version>.*)$',
      versioningTemplate: 'semver',
    },
    {
      // The crossplane/crossplane release every vendored run_function.proto
      // was copied from - the same tripwire function-sdk-rust carries. A bump
      // PR moves the version in the header comment of all copies at once; it
      // does NOT re-download the file or regenerate the guests' codecs, so
      // treat the PR as the signal to run `make vendor-proto` on its branch
      // (the root Makefile re-vendors every copy at the new version,
      // regenerates the codecs and refreshes the goldens) and push the
      // result. Merging it without that would claim a version the file is
      // not.
      customType: 'regex',
      description: 'crossplane/crossplane release the vendored run_function.proto came from',
      managerFilePatterns: ['/(^|/)proto/run_function\\.proto$/'],
      matchStrings: [
        'Vendored from crossplane/crossplane (?<currentValue>v\\d+\\.\\d+\\.\\d+)\\.',
      ],
      depNameTemplate: 'crossplane/crossplane',
      datasourceTemplate: 'github-releases',
    },
    {
      // The wasmtime-wasi-http release whose WASI versions a guest's
      // wit/world.wit imports, stated in a comment above its package line.
      // Same tripwire as the proto: a bump PR moves the version in every
      // comment at once; it does NOT move the imports, so treat the PR as the
      // signal to move them to the versions the release links and run
      // guestfn wit update in each guest. The versioning is stated rather
      // than the crate datasource's cargo ranges, under which `49.0.2` reads
      // as `^49.0.2`.
      customType: 'regex',
      description: 'wasmtime-wasi-http release whose WASI versions the guests import',
      managerFilePatterns: ['/(^|/)wit/world\\.wit$/'],
      matchStrings: [
        'WASI at the version wasmtime-wasi-http (?<currentValue>\\d+\\.\\d+\\.\\d+) links',
      ],
      depNameTemplate: 'wasmtime-wasi-http',
      datasourceTemplate: 'crate',
      versioningTemplate: 'semver',
    },
    {
      // The documentation site's Cedar highlighting (docs/theme/cedar.js):
      // the highlight.js 11 core and Cedar's own grammar, each vendored under
      // docs/theme (not under a vendor/ directory: ignorePaths skips those)
      // as the upstream file beneath a one-line header naming the release.
      // Same tripwire as the proto: a bump PR moves the header and does NOT
      // re-download the file, so run `make vendor-docs-highlight` on its
      // branch, which fetches both at the versions their headers name, and
      // check the Cedar pages render.
      customType: 'regex',
      description: 'highlight.js release the docs site runs the Cedar grammar on',
      managerFilePatterns: ['/^docs/theme/highlightjs/core\\.min\\.js$/'],
      matchStrings: [
        'Vendored from @highlightjs/cdn-assets (?<currentValue>\\d+\\.\\d+\\.\\d+) ',
      ],
      depNameTemplate: '@highlightjs/cdn-assets',
      datasourceTemplate: 'npm',
    },
    {
      customType: 'regex',
      description: 'cedar-policy/highlightjs-cedar release the docs site highlights Cedar with',
      managerFilePatterns: ['/^docs/theme/highlightjs-cedar/hljs-cedar\\.esm\\.js$/'],
      matchStrings: [
        'Vendored from cedar-policy/highlightjs-cedar (?<currentValue>v\\d+\\.\\d+\\.\\d+) ',
      ],
      depNameTemplate: 'cedar-policy/highlightjs-cedar',
      datasourceTemplate: 'github-releases',
    },
    {
      // Vale, the prose linter the Makefile installs under .cache/tools for
      // `make vale` (run by the docs workflow too): a `# renovate:` comment
      // above the VALE_VERSION pin. Releases are tagged vX.Y.Z; the pin
      // carries no v.
      customType: 'regex',
      description: 'the Vale release the Makefile installs',
      managerFilePatterns: ['/^Makefile$/'],
      matchStrings: [
        '# renovate: datasource=(?<datasource>[^\\s]+) depName=(?<depName>[^\\s]+)\\s+VALE_VERSION := (?<currentValue>\\d+\\.\\d+\\.\\d+)',
      ],
      extractVersionTemplate: '^v(?<version>.*)$',
      versioningTemplate: 'semver',
    },
    {
      // The Vale style packages .vale.ini syncs, each pinned to a GitHub
      // release by URL (a bare catalog name floats). A bump PR moves the
      // URL; `make vale` re-syncs on the next run, since the stamp file
      // depends on .vale.ini, and the docs workflow proves the new rules.
      customType: 'regex',
      description: 'the Vale style packages .vale.ini pins',
      managerFilePatterns: ['/^\\.vale\\.ini$/'],
      matchStrings: [
        'https://github\\.com/(?<depName>[^/\\s]+/[^/\\s]+)/releases/download/(?<currentValue>v\\d+\\.\\d+\\.\\d+)/',
      ],
      datasourceTemplate: 'github-releases',
    },
  ],
  // Rules are evaluated in order; later rules win.
  packageRules: [
    // The two Firecracker matches of crates/function-oci/Dockerfile (one
    // checksum per architecture, each with the version beside it) are one
    // dependency:
    // one PR moves the version and both digests, and it is the signal for
    // the kernel bump by hand.
    {
      matchDepNames: ['firecracker', 'firecracker-microvm/firecracker'],
      groupName: 'firecracker',
    },
    // GitHub Actions: let a release settle before pulling its digest, batch
    // non-major bumps into one PR, and keep majors as separate PRs since they
    // tend to need workflow changes.
    { matchManagers: ['github-actions'], minimumReleaseAge: '3 days' },
    {
      matchManagers: ['github-actions'],
      matchUpdateTypes: ['minor', 'patch', 'digest', 'pin', 'pinDigest'],
      groupName: 'github-actions',
    },

    // The workspace crates move together.
    { matchManagers: ['cargo'], groupName: 'rust' },

    // The wasmtime crates pin one another to exact versions (`=48.0.4`), so
    // they resolve only as one family. For a lockfile-only update Renovate
    // runs `cargo update --precise` crate by crate, and each of those fails
    // on the siblings' pins; once the manifest requirement changes it skips
    // that step and one `cargo update --workspace` moves the whole family.
    // Hence their own group, and `bump` so every update changes Cargo.toml.
    // The WASI comments in the guests' worlds join the group, so the PR that moves
    // the crates is also the one that asks for moving the guests' imports. So does
    // the wasip1 adapter provider: built in the wasmtime repository and
    // published at its version, it is the adapter guestfn build links into
    // a component (crates/engine-wasm/src/componentize.rs) and must stay the one
    // the engine's wasmtime-wasi was released with.
    {
      matchManagers: ['cargo', 'custom.regex'],
      matchPackageNames: ['wasmtime', 'wasmtime-*', 'wasi-preview1-component-adapter-provider'],
      groupName: 'wasmtime',
      rangeStrategy: 'bump',
    },
    // wit-component, wasmparser and wit-parser state an open requirement
    // (crates/engine-wasm/Cargo.toml) and are held in Cargo.lock at the
    // versions wasmtime's own bindgen pulls, so one copy is compiled; wat is
    // held there at the release whose wasm-encoder wasmtime's is. Which
    // versions those are is written in the wasmtime crates' manifests alone,
    // where no datasource reads it: a bump of any of the four on its own
    // would go to the newest release, which is ahead of what the current
    // wasmtime depends on, and add the second copy deny.toml refuses (#140).
    // So Renovate leaves them alone, and the wasmtime group's pull request
    // fails its deny job until they are moved on its branch, with the
    // commands the manifest gives, to what the new wasmtime pulls.
    {
      matchManagers: ['cargo'],
      matchPackageNames: ['wit-component', 'wasmparser', 'wit-parser', 'wat'],
      enabled: false,
    },
    // kube and k8s-openapi (the end-to-end suite's, crates/e2e/Cargo.toml)
    // move together: each kube major is built against one k8s-openapi
    // minor (kube 4 on 0.28, kube 5 on 0.29), and k8s-openapi's build
    // script refuses a second copy of itself with no v1_* feature on it,
    // which is what either bumped alone leaves in Cargo.lock - the suite's
    // copy with its feature beside kube's without (#200, #227). The two
    // sides are a 0.x minor and a major, so the group also keeps majors
    // in: with separateMajorMinor Renovate would still split them into
    // renovate/kube and renovate/major-kube, each failing the same way.
    {
      matchManagers: ['cargo'],
      matchPackageNames: ['kube', 'kube-*', 'k8s-openapi'],
      groupName: 'kube',
      separateMajorMinor: false,
    },

    // Dockerfile: the rust build stage floats by design; the runtime base is
    // pinned to a digest that moves with Chainguard's daily rebuilds - one PR
    // per digest bump, so a rebuild that breaks the image is judged on its
    // own.
    { matchManagers: ['dockerfile'], matchPackageNames: ['rust'], enabled: false },
    {
      matchManagers: ['dockerfile'],
      matchPackageNames: ['cgr.dev/chainguard/glibc-dynamic'],
      pinDigests: true,
      groupName: 'runtime image',
    },

    // Nothing under the example guests or the scaffold goldens (see the
    // surface note above), but for the exceptions below.
    {
      matchFileNames: ['examples/**', 'crates/guestfn/testdata/**'],
      enabled: false,
    },

    // The Go toolchain image function-oci-go's Dockerfile builds with, which
    // the dockerfile manager reads: the example is published, so its
    // toolchain takes Go's releases with the monthly batch below. go.mod's
    // go directive, which moves with a release, states the minimum, and the
    // image may run ahead of it.
    {
      matchManagers: ['dockerfile'],
      matchFileNames: ['examples/function-oci-go/Dockerfile'],
      matchPackageNames: ['golang'],
      enabled: true,
    },

    // The one exception, and the reason it is safe: the vendored proto's
    // version header is the same dep in all sixteen copies, so Renovate
    // moves templates, goldens and examples in a single PR - the examples
    // only because ignorePaths above no longer skips them. Left disabled
    // under those paths it would update the templates alone - desyncing the
    // very copies the rule above exists to protect. Scoped to the proto
    // files: the end-to-end suite's Crossplane pins below are the same
    // package under other rules.
    {
      matchManagers: ['custom.regex'],
      matchFileNames: ['**/proto/run_function.proto'],
      matchPackageNames: ['crossplane/crossplane'],
      enabled: true,
      groupName: 'vendored run_function.proto',
    },
    // The end-to-end suite's Crossplane versions (the regex manager above):
    // the matrix's two older pins follow the latest patch of their own minor
    // only - Crossplane maintains its three most recent minors, and the pins
    // name the two before the Makefile's default - while the default takes
    // any release. One PR moves whatever moved; a PR that moves the default
    // to a new minor is the signal to shift the two pins down one minor by
    // hand in that PR (docs/project/testing.md).
    {
      matchManagers: ['custom.regex'],
      matchFileNames: ['.github/workflows/release-matrix-e2e.yml'],
      matchDepNames: ['crossplane/crossplane', 'firecracker-microvm/firecracker'],
      matchUpdateTypes: ['major', 'minor'],
      enabled: false,
    },
    {
      matchManagers: ['custom.regex'],
      matchFileNames: ['Makefile', '.github/workflows/release-matrix-e2e.yml'],
      matchDepNames: ['crossplane/crossplane'],
      groupName: 'crossplane e2e',
    },
    // The WASI WIT headers, for the same reason: one dep across the rust,
    // python and go templates, their goldens, function-wasm-rust,
    // function-wasm-python, function-wasm-c, function-wasm-zig, function-wasm-odin, function-wasm-moonbit, function-wasm-go and
    // function-wasm-csharp.
    // Their group is the wasmtime one above.
    {
      matchManagers: ['custom.regex'],
      matchPackageNames: ['wasmtime-wasi-http'],
      enabled: true,
    },
    // The docs site's Cedar grammar is written for one highlight.js major,
    // so a bump of either is judged with the other in one PR.
    {
      matchManagers: ['custom.regex'],
      matchPackageNames: ['@highlightjs/cdn-assets', 'cedar-policy/highlightjs-cedar'],
      groupName: 'docs Cedar highlighting',
    },
    // The generators: every copy of a pin is one dependency, so one pull
    // request moves the Makefile and the workflows together (wit-bindgen's
    // come from two managers, the workflows' with their checksum).
    {
      matchManagers: ['custom.regex'],
      matchDepNames: ['bytecodealliance/wit-bindgen'],
      groupName: 'wit-bindgen',
    },
    { matchManagers: ['custom.regex'], matchDepNames: ['protocolbuffers/protobuf'], groupName: 'protoc' },
    { matchManagers: ['custom.regex'], matchDepNames: ['nanopb'], groupName: 'nanopb' },
    // The build submodule follows crossplane/build's main branch, which
    // moves often: one pull request a month, with the examples batch.
    { matchManagers: ['git-submodules'], schedule: ['* 0-3 1 * *'] },
    // Vale and its style packages: the binary's pin in the Makefile and the
    // package URLs in .vale.ini move in one PR, which the docs workflow's
    // prose job checks against the whole book.
    {
      matchManagers: ['custom.regex'],
      matchDepNames: [
        'errata-ai/vale',
        'errata-ai/Google',
        'errata-ai/Microsoft',
        'errata-ai/proselint',
        'errata-ai/write-good',
        'tbhb/vale-ai-tells',
      ],
      groupName: 'vale',
    },

    // The monthly examples refresh. The examples are illustrative and never
    // shipped (the image holds only the runtime binary), so one batch a
    // month, judged by the e2e:all label, keeps them current. These rules
    // switch back on only what an example owns alone, never a pin the templates share.
    //
    // Lock file maintenance: off everywhere first, so the workspace's
    // Cargo.lock keeps the runtime's rules above, then on for the example
    // lockfiles. The lockfiles move within the manifests' ranges and the
    // manifests stay as they are, so nothing drifts from the templates.
    { matchUpdateTypes: ['lockFileMaintenance'], enabled: false },
    {
      matchUpdateTypes: ['lockFileMaintenance'],
      matchFileNames: [
        'examples/function-wasm-rust/Cargo.toml',
        'examples/function-wasm-ts/package.json',
      ],
      enabled: true,
    },
    // gomod has no lock file maintenance, so the Go examples (the wasm one and
    // the OCI one, which shares its pins) take regular updates. `enabled` here also covers their indirect requirements,
    // which gomod extracts disabled. gomodTidy leaves go.mod and go.sum
    // tidy, so a bump never leaves go.sum behind.
    {
      matchManagers: ['gomod'],
      matchFileNames: ['examples/function-wasm-go/go.mod', 'examples/function-oci-go/go.mod'],
      enabled: true,
      postUpdateOptions: ['gomodTidy'],
    },
    // ...except what the scaffold template pins, which moves with a release
    // instead: the go directive (it also picks the Go toolchain the
    // example jobs install), the go template's function-sdk-go (FALLBACK_SDK_VERSION
    // in crates/guestfn/src/main.rs) and the runtime of its wit-bindgen Go
    // bindings, go.bytecodealliance.org/pkg, pinned at the version the
    // generator targets (it moves with a wit-bindgen bump and `make
    // gen-bindings`, never on its own).
    {
      matchFileNames: ['examples/function-wasm-go/go.mod', 'examples/function-oci-go/go.mod'],
      matchPackageNames: ['go', 'github.com/crossplane/function-sdk-go', 'go.bytecodealliance.org/pkg'],
      enabled: false,
    },
    // ...and k8s.io/kube-openapi, an indirect requirement with no tagged
    // release, which follows apimachinery instead: apimachinery pins the
    // commit it was built with, and a bump of apimachinery carries it
    // there through go get and gomodTidy. Bumped on its own to the newest
    // commit it outran apimachinery (#225: the 2026-11-04 commit built on
    // structured-merge-diff v7 and required Go 1.27 while apimachinery
    // v0.37.2 still built on v6, so the guest failed to compile and the go
    // directive rose with it).
    {
      matchManagers: ['gomod'],
      matchFileNames: ['examples/function-wasm-go/go.mod', 'examples/function-oci-go/go.mod'],
      matchPackageNames: ['k8s.io/kube-openapi'],
      enabled: false,
    },
    // function-wasm-csharp is example-only, with no template to drift from: its
    // NuGet packages take regular updates. nuget reads every version from
    // its Directory.Packages.props (the projects name packages without one)
    // and looks them up in the sources its nuget.config names.
    {
      matchManagers: ['nuget'],
      matchFileNames: ['examples/function-wasm-csharp/**'],
      enabled: true,
    },
    // ...except NativeAOT-LLVM: componentize-dotnet is built against one
    // build of it from the dotnet-experimental feed (which publishes a new
    // one most days), and the compiler for the build host must be that same
    // build. They stay pinned to what componentize-dotnet was released with
    // and move by hand, when a componentize-dotnet update arrives in the
    // batch below - that PR is the signal, and build (dotnet) fails until they move.
    {
      matchManagers: ['nuget'],
      matchPackageNames: ['/^(runtime\\.[a-z0-9-]+\\.)?Microsoft\\.DotNet\\.ILCompiler\\.LLVM$/i'],
      enabled: false,
    },
    // function-wasm-python's requirements.txt is the python template's: its
    // componentize-py and protobuf pins move with the template at release
    // time (the cut-release skill), never in this batch - pip_requirements
    // is not an enabled manager.
    //
    // function-wasm-zig, function-wasm-c, function-wasm-cpp and function-wasm-odin name
    // their dependencies in build.zig.zon by URL and content hash, which no
    // Renovate manager reads: they move by hand at release time (the
    // cut-release skill; function-wasm-odin's nanopb pin is function-wasm-c's). function-wasm-moonbit's one
    // dependency (moonbitlang/protobuf in moon.mod.json) has no Renovate
    // manager either: it moves by hand, with the generator pins in its
    // Makefile, at release time.
    //
    // One batch, early on the 1st of the month. Renovate does not group lock
    // file maintenance with other updates - a grouped one gets its own
    // lock-file-maintenance- branch - so the batch is two PRs:
    // renovate/examples (the Go examples and function-wasm-csharp) and
    // renovate/lock-file-maintenance-examples (the four lockfiles). A major
    // rides in its batch instead of a PR of its own; the e2e:all label judges the whole.
    // A security update to a Go or .NET example dependency still opens at
    // once on its own branch: Renovate appends those rules after these, with
    // `force`.
    {
      matchManagers: ['cargo', 'npm', 'gomod', 'nuget', 'dockerfile'],
      matchFileNames: ['examples/**'],
      groupName: 'examples',
      schedule: ['* 0-3 1 * *'],
      separateMajorMinor: false,
    },
    // An indirect requirement's major version is its importer's choice: a
    // bump across it (yaml.v2 to yaml.v3, a /vN path) would replace a module
    // the build still imports instead of updating it. Lookup keeps majors
    // apart for these, so the newest minor or patch is still proposed, and
    // the major is dropped.
    {
      matchManagers: ['gomod'],
      matchFileNames: ['examples/function-wasm-go/go.mod', 'examples/function-oci-go/go.mod'],
      matchDepTypes: ['indirect'],
      separateMajorMinor: true,
    },
    {
      matchManagers: ['gomod'],
      matchFileNames: ['examples/function-wasm-go/go.mod', 'examples/function-oci-go/go.mod'],
      matchDepTypes: ['indirect'],
      matchUpdateTypes: ['major'],
      enabled: false,
    },
    // Auto-merge, last so that nothing above overrides it. Every pull
    // request here runs the whole end-to-end suite (the e2e:all label) and
    // merges only once the checks the ruleset on main requires have passed.
    // What merges by itself: a patch, a pinned digest, lock file
    // maintenance, and a minor of a dependency that has reached 1.0. A 0.x
    // minor may break, and a major does, so both wait for a person.
    {
      matchUpdateTypes: ['patch', 'pin', 'pinDigest', 'digest', 'lockFileMaintenance'],
      automerge: true,
    },
    { matchUpdateTypes: ['minor'], matchCurrentVersion: '>=1.0.0', automerge: true },
    // A release waits three days before it is proposed, as an action's
    // does, so one pulled or replaced within hours never merges.
    { matchManagers: ['cargo', 'npm', 'gomod', 'nuget'], minimumReleaseAge: '3 days' },
    // Never by itself, whatever the size of the bump: the sandbox
    // (wasmtime and what moves with it), signature verification, both
    // policy layers' engine, the VMM, and the updates that are the signal
    // for a step by hand (the vendored proto and the docs highlighter need
    // their make targets run, a Vale update can need prose changed, and
    // the examples batch is read as a whole).
    {
      matchPackageNames: [
        'wasmtime',
        'wasmtime-*',
        'wasmtime-wasi-http',
        'wasi-preview1-component-adapter-provider',
        'sigstore-*',
        'cedar-policy',
        'cedar-policy-*',
        '@highlightjs/cdn-assets',
        'cedar-policy/highlightjs-cedar',
      ],
      automerge: false,
    },
    {
      matchDepNames: [
        'firecracker',
        'firecracker-microvm/firecracker',
        'crossplane/crossplane',
        '/^errata-ai//',
        'tbhb/vale-ai-tells',
        // The Crossplane CLI needs its checksum added by hand, and no check
        // on a pull request runs the workflow that installs it.
        'crossplane/cli',
        // The generators need what they wrote regenerated.
        'bytecodealliance/wit-bindgen',
        'protocolbuffers/protobuf',
        'nanopb',
      ],
      automerge: false,
    },
    // The build submodule moves the cluster tools of every end-to-end job.
    { matchManagers: ['git-submodules'], automerge: false },
    { matchFileNames: ['examples/**'], automerge: false },
    { matchUpdateTypes: ['major'], automerge: false },
  ],
}
