{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:recommended',
    // Workflows pin every action to a commit SHA with a `# vX.Y.Z` comment;
    // keep it that way and resolve the comment to a full semver tag.
    'helpers:pinGitHubActionDigestsToSemver',
    // The repo uses conventional commits; a routine bump is a chore, not a fix.
    ':semanticCommitTypeAll(chore)',
  ],
  // The dependency surfaces: the Cargo workspace, the workflows (actions and
  // the CLI versions in their env), and the Dockerfile. The Dockerfile's
  // rust:1 build stage floats by design; its runtime base
  // (cgr.dev/chainguard/glibc-dynamic, a `latest`-only image) is digest-pinned
  // and the dockerfile manager keeps that digest current.
  //
  // The example guests and the scaffold goldens are NOT a surface: they
  // mirror the templates under crates/guestfn/templates, which Renovate
  // cannot parse (`.tmpl`), so a bot bump desyncs the three copies and fails
  // the render-matches goldens. Their dependencies - and the function package
  // refs in their render files - move by hand, together with the templates.
  enabledManagers: ['cargo', 'github-actions', 'dockerfile', 'custom.regex'],
  osvVulnerabilityAlerts: true,
  customManagers: [
    {
      // Crossplane CLI version installed by install.sh in the release workflows.
      // Since v2.3.0 the CLI is released from crossplane/cli (XP_CHANNEL=stable).
      customType: 'regex',
      description: 'XP_VERSION in .github/workflows',
      managerFilePatterns: ['/^\\.github/workflows/[^/]+\\.ya?ml$/'],
      matchStrings: ["XP_VERSION: '(?<currentValue>v[^']+)'"],
      depNameTemplate: 'crossplane/cli',
      datasourceTemplate: 'github-releases',
    },
    {
      // The crossplane/crossplane release every vendored run_function.proto
      // was copied from - the same tripwire function-sdk-rust carries. A bump
      // PR moves the version in the header comment of all copies at once; it
      // does NOT re-download the file, so treat the PR as the signal to
      // re-vendor by hand (the header says how) and regenerate each guest's
      // checked-in codec. Merging it without re-vendoring would claim a
      // version the file is not.
      customType: 'regex',
      description: 'crossplane/crossplane release the vendored run_function.proto came from',
      managerFilePatterns: ['/(^|/)proto/run_function\\.proto$/'],
      matchStrings: [
        'Vendored from crossplane/crossplane (?<currentValue>v\\d+\\.\\d+\\.\\d+)\\.',
      ],
      depNameTemplate: 'crossplane/crossplane',
      datasourceTemplate: 'github-releases',
    },
  ],
  // Rules are evaluated in order; later rules win.
  packageRules: [
    // GitHub Actions: let a release settle before pulling its digest, batch
    // non-major bumps into one PR, and keep majors as separate PRs since they
    // tend to need workflow changes.
    { matchManagers: ['github-actions'], minimumReleaseAge: '3 days' },
    {
      matchManagers: ['github-actions'],
      matchUpdateTypes: ['minor', 'patch', 'digest', 'pin', 'pinDigest'],
      groupName: 'github-actions',
    },

    // The workspace crates move together.
    { matchManagers: ['cargo'], groupName: 'rust' },

    // Dockerfile: the rust build stage floats by design; the runtime base is
    // pinned to a digest that moves with Chainguard's daily rebuilds - one PR
    // per digest bump, so a rebuild that breaks the image is judged on its
    // own.
    { matchManagers: ['dockerfile'], matchPackageNames: ['rust'], enabled: false },
    {
      matchManagers: ['dockerfile'],
      matchPackageNames: ['cgr.dev/chainguard/glibc-dynamic'],
      pinDigests: true,
      groupName: 'runtime image',
    },

    // Nothing under the example guests or the scaffold goldens (see the
    // surface note above).
    {
      matchFileNames: ['examples/**', 'crates/guestfn/testdata/**'],
      enabled: false,
    },

    // The one exception, and the reason it is safe: the vendored proto's
    // version header is the same dep in all thirteen copies, so Renovate
    // moves templates, goldens and examples in a single PR. Left disabled
    // under those paths it would update the templates alone - desyncing the
    // very copies the rule above exists to protect.
    {
      matchManagers: ['custom.regex'],
      matchPackageNames: ['crossplane/crossplane'],
      enabled: true,
      groupName: 'vendored run_function.proto',
    },
  ],
}
